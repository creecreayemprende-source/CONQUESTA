# Copia este archivo como .env.local y pega los valores reales ahí —
# .env.local nunca se sube a Git (ver .gitignore) y no se comparte en el chat.

# Supabase → Settings → API → "Project URL" y "anon / publishable key".
# Ambas son públicas por diseño (viajan al navegador), pero solo son seguras
# porque cada tabla tiene RLS activo (ver supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
